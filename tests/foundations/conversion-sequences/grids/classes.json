{
 "prelude": "template <class T, class U> constexpr bool same = false;\ntemplate <class T> constexpr bool same<T, T> = true;\nstruct One {};\nstruct Two {};\nstruct Base {};\nstruct Middle : Base {};\nstruct Derived : Middle {};\nstruct Box { Box(int); };\nstruct ToMiddle { operator Middle() const; };\nstruct ToInt { operator int() const; };\nDerived d;\n",
 "template": "{prelude}\nOne f({a});\nTwo f({b});\n{row}",
 "rows": {
  "Derived lvalue → first": "static_assert(same<decltype(f(d)), One>);",
  "Derived lvalue → second": "static_assert(same<decltype(f(d)), Two>);",
  "Derived prvalue → first": "static_assert(same<decltype(f(Derived{})), One>);",
  "Derived prvalue → second": "static_assert(same<decltype(f(Derived{})), Two>);",
  "Middle prvalue → first": "static_assert(same<decltype(f(Middle{})), One>);",
  "Middle prvalue → second": "static_assert(same<decltype(f(Middle{})), Two>);",
  "int → first": "static_assert(same<decltype(f(1)), One>);",
  "int → second": "static_assert(same<decltype(f(1)), Two>);",
  "ToMiddle → first": "static_assert(same<decltype(f(ToMiddle{})), One>);",
  "ToMiddle → second": "static_assert(same<decltype(f(ToMiddle{})), Two>);",
  "ToInt → first": "static_assert(same<decltype(f(ToInt{})), One>);",
  "ToInt → second": "static_assert(same<decltype(f(ToInt{})), Two>);"
 },
 "pairs": {
  "Base": "Base",
  "Middle": "Middle",
  "const Middle lref": "const Middle&",
  "Middle rref": "Middle&&",
  "long": "long",
  "Box": "Box",
  "ellipsis": "..."
 }
}
