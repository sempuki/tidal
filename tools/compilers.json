{
  "comment": "Compiler matrix for tools/run_tests.py. See docs/decisions/0008.",
  "compilers": [
    {
      "id": "clang-host",
      "family": "clang",
      "role": "baseline",
      "check": [
        "clang++",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "-c",
        "{src}",
        "-o",
        "{out}.o"
      ],
      "build": [
        "clang++",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "{src}",
        "-o",
        "{out}"
      ],
      "version": [
        "clang++",
        "--version"
      ]
    },
    {
      "id": "gcc-host",
      "family": "gcc",
      "role": "baseline",
      "check": [
        "g++",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "-c",
        "{src}",
        "-o",
        "{out}.o"
      ],
      "build": [
        "g++",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "{src}",
        "-o",
        "{out}"
      ],
      "version": [
        "g++",
        "--version"
      ]
    },
    {
      "id": "edg-7.0",
      "family": "edg",
      "role": "baseline",
      "image": {
        "dockerfile": "edg.Dockerfile",
        "args": {
          "EDG_REF": "7.0"
        }
      },
      "check": [
        "cpfe",
        "--c++23",
        "--strict",
        "--no_code_gen",
        "--instantiate=used",
        "{flags}",
        "{src}"
      ],
      "version": [
        "cpfe",
        "--version"
      ],
      "unsupported_flags": [
        "-m32",
        "-Wall",
        "-Werror",
        "-O2",
        "-fsanitize=*",
        "-fno-sanitize-recover=*"
      ]
    },
    {
      "id": "edg-7.0-ilp32",
      "family": "edg",
      "role": "baseline",
      "image": {
        "dockerfile": "edg-i686.Dockerfile",
        "args": {
          "EDG_REF": "7.0"
        }
      },
      "check": [
        "cpfe",
        "--c++23",
        "--strict",
        "--no_code_gen",
        "--instantiate=used",
        "{flags}",
        "{src}"
      ],
      "version": [
        "cpfe",
        "--version"
      ],
      "unsupported_flags": [
        "-Wall",
        "-Werror",
        "-O2",
        "-fsanitize=*",
        "-fno-sanitize-recover=*"
      ],
      "required_flags": [
        "-m32"
      ],
      "drop_flags": [
        "-m32"
      ]
    },
    {
      "id": "gcc-14",
      "family": "gcc",
      "role": "baseline",
      "image": {
        "dockerfile": "apt.Dockerfile",
        "args": {
          "PACKAGES": "g++-14 g++-14-multilib"
        }
      },
      "check": [
        "g++-14",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "-c",
        "{src}",
        "-o",
        "{out}.o"
      ],
      "build": [
        "g++-14",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "{src}",
        "-o",
        "{out}"
      ],
      "version": [
        "g++-14",
        "--version"
      ]
    },
    {
      "id": "clang-18",
      "family": "clang",
      "role": "baseline",
      "image": {
        "dockerfile": "apt.Dockerfile",
        "args": {
          "PACKAGES": "clang-18 libclang-rt-18-dev g++-multilib"
        }
      },
      "check": [
        "clang++-18",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "-c",
        "{src}",
        "-o",
        "{out}.o"
      ],
      "build": [
        "clang++-18",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "{src}",
        "-o",
        "{out}"
      ],
      "version": [
        "clang++-18",
        "--version"
      ]
    },
    {
      "id": "gcc-16",
      "family": "gcc",
      "role": "baseline",
      "image": {
        "dockerfile": "official.Dockerfile",
        "args": {
          "IMAGE": "docker.io/library/gcc:16"
        }
      },
      "check": [
        "g++",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "-c",
        "{src}",
        "-o",
        "{out}.o"
      ],
      "build": [
        "g++",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "{src}",
        "-o",
        "{out}"
      ],
      "version": [
        "g++",
        "--version"
      ],
      "unsupported_flags": [
        "-m32"
      ]
    },
    {
      "id": "gcc-16-o2",
      "family": "gcc",
      "role": "report",
      "image": {
        "dockerfile": "official.Dockerfile",
        "args": {
          "IMAGE": "docker.io/library/gcc:16"
        }
      },
      "check": [
        "g++",
        "-std=c++23",
        "-pedantic-errors",
        "-O2",
        "{flags}",
        "-c",
        "{src}",
        "-o",
        "{out}.o"
      ],
      "build": [
        "g++",
        "-std=c++23",
        "-pedantic-errors",
        "-O2",
        "{flags}",
        "{src}",
        "-o",
        "{out}"
      ],
      "version": [
        "g++",
        "--version"
      ],
      "unsupported_flags": [
        "-m32"
      ],
      "variant_of": "gcc-16"
    },
    {
      "id": "clang-22",
      "family": "clang",
      "role": "baseline",
      "image": {
        "dockerfile": "llvm.Dockerfile",
        "args": {
          "LLVM_VERSION": "22"
        }
      },
      "check": [
        "clang++-22",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "-c",
        "{src}",
        "-o",
        "{out}.o"
      ],
      "build": [
        "clang++-22",
        "-std=c++23",
        "-pedantic-errors",
        "{flags}",
        "{src}",
        "-o",
        "{out}"
      ],
      "version": [
        "clang++-22",
        "--version"
      ]
    },
    {
      "id": "clang-22-o2",
      "family": "clang",
      "role": "report",
      "image": {
        "dockerfile": "llvm.Dockerfile",
        "args": {
          "LLVM_VERSION": "22"
        }
      },
      "check": [
        "clang++-22",
        "-std=c++23",
        "-pedantic-errors",
        "-O2",
        "{flags}",
        "-c",
        "{src}",
        "-o",
        "{out}.o"
      ],
      "build": [
        "clang++-22",
        "-std=c++23",
        "-pedantic-errors",
        "-O2",
        "{flags}",
        "{src}",
        "-o",
        "{out}"
      ],
      "version": [
        "clang++-22",
        "--version"
      ],
      "variant_of": "clang-22"
    }
  ]
}
