    {"id": "clang-sema-stmt", "repo": "llvm", "path": "clang/lib/Sema/SemaStmt.cpp", "class": "sanitized"},
    {"id": "clang-sema-expr", "repo": "llvm", "path": "clang/lib/Sema/SemaExpr.cpp", "class": "sanitized"},
    {"id": "clang-diag-sema", "repo": "llvm", "path": "clang/include/clang/Basic/DiagnosticSemaKinds.td", "class": "sanitized"},
    {"id": "clang-diag-parse", "repo": "llvm", "path": "clang/include/clang/Basic/DiagnosticParseKinds.td", "class": "sanitized"},
    {"id": "gcc-cp-parser", "repo": "gcc", "path": "gcc/cp/parser.cc", "class": "sanitized"},
    {"id": "gcc-cp-semantics", "repo": "gcc", "path": "gcc/cp/semantics.cc", "class": "sanitized"},
    {"id": "gcc-cp-typeck", "repo": "gcc", "path": "gcc/cp/typeck.cc", "class": "sanitized"}
