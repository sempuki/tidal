      "github": "llvm/llvm-project",
      "ref": "llvmorg-22.1.8",
      "license": "Apache-2.0 WITH LLVM-exception"
    },
    "gcc": {
      "github": "gcc-mirror/gcc",
      "ref": "releases/gcc-16.2.0",
